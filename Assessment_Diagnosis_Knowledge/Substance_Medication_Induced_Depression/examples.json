  "messages": [
    {
      "id": "m1",
      "speaker": "assistant",
      "text": "What has changed recently?"
    },
    {
      "id": "m2",
      "speaker": "patient",
      "text": "I feel down. I started prednisone three weeks ago for my arthritis. I also take Medicine B, but I cannot remember when I started it."
    },
    {
      "id": "m3",
      "speaker": "assistant",
      "text": "Did the low mood begin after you started prednisone?"
    },
    {
      "id": "m4",
      "speaker": "patient",
      "text": "Yes, about a week after starting it."
    },
    {
      "id": "m5",
      "speaker": "assistant",
      "text": "Have you had a similar low period before taking prednisone?"
    },
    {
      "id": "m6",
      "speaker": "patient",
      "text": "Yes, I felt low for two months last year, before I ever took prednisone."
    },
    {
      "id": "m7",
      "speaker": "assistant",
      "text": "Has either medicine changed recently?"
    },
    {
      "id": "m8",
      "speaker": "patient",
      "text": "I missed Medicine B for two days last week. I have not changed prednisone."
    }
